{
  "Urls": "http://*:8350",
  "Sds": {
    "Volume": "C:",
    "ImagesShareName": "images",
    "DriversShareName": "drivers",
    "CreateShares": true,
    "ApplyDefaultAcls": true,
    "CreateLocalGroups": true,
    "CreateFirewallRule": true,
    "FirewallRuleName": "SDS Server (TCP-In)",
    "Compression": "Lzx",
    "MaxConcurrentJobs": 2,
    "StagingRetentionHours": 24,
    "AdministratorsGroup": "SDS Administrators",
    "OperatorsGroup": "SDS Operators",
    "ExtraAdministratorGroups": [],
    "ExtraOperatorGroups": [],
    "EventLog": true,
    "CorsOrigins": [ "http://localhost:8351" ],
    "ActiveDirectory": {
      "Enabled": false,
      "LdapPath": "",
      "DefaultOrganizationalUnit": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
